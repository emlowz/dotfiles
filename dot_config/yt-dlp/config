# Keep the best SDR resolution and original frame rate. Unknown dynamic range
# is allowed for sites that omit it; the compatibility processor checks the file.
--format
bv*[dynamic_range=?SDR]+ba/b[dynamic_range=?SDR]

# Prefer compatible codecs at the same resolution/frame rate.
--format-sort
res,fps,vcodec:h264,acodec:aac

# MKV is only an intermediate container. The local processor produces H.264
# (8-bit 4:2:0) + AAC MP4, copying streams that already meet those requirements.
# Unlike --recode-video mp4, it also checks codecs inside existing MP4 files.
# Audio extraction and explicit other containers (yt --no-convert) bypass it.
--merge-output-format
mkv
--use-postprocessor
CompatibleMP4

# Stable, readable filenames that avoid collisions across sites/playlists.
--output
"%(title).200B [%(id)s].%(ext)s"

# Do not overwrite an existing output file in the current destination.
--no-overwrites

# Continue partially downloaded files when possible.
--continue

# Always use IPv4 for outgoing connections.
-4

# Use YouTube's mobile-web client with an on-demand Proof-of-Origin token.
# The provider is installed by the chezmoi bgutil setup script.
--extractor-args
youtube:player_client=mweb
--extractor-args
youtubepot-bgutilscript:server_home=~/.local/share/bgutil-ytdlp-pot-provider/server

# Better resilience for long playlists and flaky segmented streams
--concurrent-fragments
4
--retries
infinite
--fragment-retries
infinite
--retry-sleep
http:exp=1:20
--retry-sleep
fragment:exp=1:20

# Preserve useful metadata in the final media file
--embed-metadata
--embed-chapters
--embed-thumbnail

# Do not download separate subtitle sidecar files.
--no-write-subs
--no-write-auto-subs

# Keep terminal output readable during large downloads
--progress
--progress-delta
1
