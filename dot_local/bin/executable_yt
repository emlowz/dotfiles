#!/bin/sh

convert=1
subtitles=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-convert)
      convert=0
      shift
      ;;
    with-subtitles | with-subs | subs)
      subtitles=1
      shift
      ;;
    help | --help | -h)
      cat <<'EOF'
usage:
  yt [--no-convert] [yt-dlp options] URL...
  yt [--no-convert] with-subtitles [yt-dlp options] URL...

By default, save the best SDR video as H.264/AAC MP4 for Final Cut and players.
Incompatible streams are converted; compatible streams are copied losslessly.
Wait for post-processing to finish before importing the completed MP4.

options:
  --no-convert     Keep source codecs in MKV (may not import into Final Cut).

subcommands:
  with-subtitles   Download English subtitles when available and embed them.
EOF
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [ "$convert" -eq 1 ]; then
  if [ "$subtitles" -eq 1 ]; then
    exec yt-dlp \
      --write-subs \
      --write-auto-subs \
      --sub-langs 'en' \
      --sub-format best \
      --embed-subs \
      "$@"
  fi

  exec yt-dlp \
    "$@"
fi

if [ "$subtitles" -eq 1 ]; then
  exec yt-dlp \
    --format 'bv*+ba/b' \
    --preset-alias mkv \
    --write-subs \
    --write-auto-subs \
    --sub-langs 'en' \
    --sub-format best \
    --embed-subs \
    "$@"
fi

exec yt-dlp \
  --format 'bv*+ba/b' \
  --preset-alias mkv \
  "$@"
